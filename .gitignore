# Build output — anchored with a leading slash so `src/chatbox/` (the sources) is not ignored.
/chatbox
/chatbox-mcp

# Runtime state — NEVER commit these.
# chatbox.token is the shared secret; chatbox.sqlite* holds message history.
/chatbox.token
/chatbox.sqlite
/chatbox.sqlite-*
/chatbox.log
*.bak-*
*.sqlite.bak-*

# Test scratch — throwaway server state written by tests/protocol.sh
tests/.scratch/

# Release output — release.sh's scratch build, stage and archives.
/dist/

# macOS
.DS_Store
